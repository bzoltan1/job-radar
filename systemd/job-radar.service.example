[Unit]
Description=Job Radar Scraper & Sync Service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Adjust WorkingDirectory and ExecStart to your local path.
# In systemd user units, %h expands to your home directory (e.g. /home/username).
WorkingDirectory=%h/ws/job-radar
ExecStart=%h/ws/job-radar/run_radar_cron.sh
StandardOutput=journal
StandardError=journal
