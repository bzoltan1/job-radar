# Job Radar environment configuration. Copy to .env (git-ignored).
# Env vars override data/profile.local.yaml. Nothing here has a built-in default in code.

# --- Location & eligibility (REQUIRED: here or candidate.location in the profile) ---
# Country of residence; must be a key of data/countries.yaml (add yours there if missing)
CANDIDATE_COUNTRY=
# Comma-separated secondary countries you can work in or relocate to
CANDIDATE_ALLOWED_COUNTRIES=
# CANDIDATE_REMOTE_ONLY=false
# CANDIDATE_CITY=

# --- Telegram notifications (optional) ---
# Token from @BotFather; chat id from @userinfobot or similar.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Or read the token from a JSON file {"telegram": {"bot_token": "..."}}
# TELEGRAM_CONFIG_JSON=
# Alert thresholds. Unset salary threshold = salary alone never triggers an alert.
JOB_RADAR_NOTIFY_MIN_SCORE=
JOB_RADAR_NOTIFY_MIN_SALARY=

# --- Obsidian export (optional; sink is skipped when unset) ---
OBSIDIAN_VAULT_PATH=

# --- Personal data file overrides (optional) ---
# Defaults: data/<name>.local.yaml, falling back to the committed examples.
# Point these at a private repo/dir to keep your setup outside this checkout.
# JOB_RADAR_PROFILE=~/job-radar-private/profile.yaml
# JOB_RADAR_TARGETS=~/job-radar-private/targets.yaml
# JOB_RADAR_TECH_STACK=~/job-radar-private/tech_stack.yaml
# JOB_RADAR_COUNTRIES=~/job-radar-private/countries.yaml
# JOB_RADAR_INTEL_DIR=~/job-radar-private/intel
# JOB_RADAR_DB=~/job-radar-private/jobs.db
# JOB_RADAR_FEED=~/job-radar-private/feed.xml
